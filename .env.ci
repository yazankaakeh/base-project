# Environment used by the GitHub Actions CI pipeline.
# Safe defaults only — no secrets. Anything sensitive (API keys, SMTP creds)
# should be injected as GitHub Actions secrets, never committed here.

APP_NAME=Codliy
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=single
LOG_LEVEL=debug

# Workflow provisions MySQL 8 as a service container on localhost:3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=test_db
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_STORE=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array
MAIL_FROM_ADDRESS="ci@codliy.test"
MAIL_FROM_NAME="Codliy CI"

# Feature flags disabled for CI speed — the public landing must boot
# even when these are off.
IS_COMING_SOON=0
AI_CHAT_ENABLED=false
